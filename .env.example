# ==============================================================================
# LEGALAI MÉXICO - VARIABLES DE ENTORNO DE CONFIGURACIÓN
# ==============================================================================

# Entorno: development | staging | production | testing
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="LegalAI México"
VERSION="1.0.0"

# Servidor Backend FastAPI
HOST=127.0.0.1
PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=cambiar_en_produccion_por_clave_segura_de_al_menos_32_caracteres_aleatorios
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# Base de Datos PostgreSQL
# Local Windows: postgresql://postgres@localhost:5432/legal_ai_db
# Docker Compose: postgresql://postgres:postgres@db:5432/legal_ai_db
# AWS RDS: postgresql://usuario:password@rds-endpoint:5432/legal_ai_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=legal_ai_db
DATABASE_URL=postgresql://postgres@localhost:5432/legal_ai_db

# Redis (Broker de Tareas Asíncronas y Caché)
# Local: redis://localhost:6379/0 (Si Redis no está corriendo, el sistema usa Fallback en DB)
# Docker: redis://redis:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Motor de Inteligencia Artificial (Ollama Local)
# Restringido estrictamente a localhost para evitar fuga de expedientes
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=bge-m3:latest
OLLAMA_LLM_MODEL=qwen3.5:4b
OLLAMA_CODER_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SECONDS=120

# Almacenamiento Documental Inmutable
# Local: local | S3/MinIO: s3
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage/tenants
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=legal-ai-documents-vault
S3_ENDPOINT_URL=

# CORS Origins (Separados por coma)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000"

# Sistema de Logs
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/legal_ai.log

# Frontend Next.js
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_APP_NAME="LegalAI México"
