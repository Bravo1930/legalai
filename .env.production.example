# ==============================================================================
# LEGALAI MÉXICO - VARIABLES DE ENTORNO DE PRODUCCIÓN (SERVIDOR PRIVADO)
# ==============================================================================
# Despliegue soberano con Nginx SSL, Docker Compose y Ollama en red interna
# ==============================================================================

# Entorno
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="LegalAI México"
VERSION="1.0.0"

# Servidor Backend
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=REEMPLAZAR_CON_STRING_CRIPTOGRAFICO_ALEATORIO_DE_64_CHARS_MINIMO
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# PostgreSQL 16 + pgvector (Contenedor interno o RDS privado)
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=legal_ai_admin
POSTGRES_PASSWORD=PASSWORD_POSTGRES_MUY_SEGURO_GENERADO_ALEATORIAMENTE
POSTGRES_DB=legal_ai_db
DATABASE_URL=postgresql://legal_ai_admin:PASSWORD_POSTGRES_MUY_SEGURO_GENERADO_ALEATORIAMENTE@db:5432/legal_ai_db

# Redis 7 con Autenticación Obligatoria
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=PASSWORD_REDIS_SEGURO_GENERADO_ALEATORIAMENTE
REDIS_URL=redis://:PASSWORD_REDIS_SEGURO_GENERADO_ALEATORIAMENTE@redis:6379/0

# Inferencia IA Soberana (Ollama en Host Local o Red Interna)
# Restringido estrictamente a IPs privadas sin salida a internet
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_KEY=TOKEN_BEARER_AUTENTICACION_OLLAMA_OPCIONAL
OLLAMA_ALLOW_PUBLIC_IPS=false
OLLAMA_VERIFY_SSL=true
OLLAMA_EMBEDDING_MODEL=bge-m3:latest
OLLAMA_LLM_MODEL=qwen3.5:4b
OLLAMA_CODER_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SECONDS=180

# Almacenamiento Documental Inmutable WORM
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/storage/tenants
STORAGE_WORM_ENABLED=true

# Respaldo Automatizado
BACKUP_ENCRYPTION_KEY=LLAVE_SIMETRICA_AES_256_PARA_ENCRIPTAR_RESPALDOS
BACKUP_RETENTION_DAYS=30

# CORS Origins (Dominio del Despacho)
CORS_ORIGINS="https://legal.despacho.com.mx,https://app.legalai.mx"

# Sistema de Logs
LOG_LEVEL=INFO
LOG_FILE_PATH=/app/logs/legal_ai_production.log

# Frontend Next.js
NEXT_PUBLIC_API_URL=https://legal.despacho.com.mx/api/v1
NEXT_PUBLIC_APP_NAME="LegalAI México"
