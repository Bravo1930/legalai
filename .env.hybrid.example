# ==============================================================================
# LEGALAI MÉXICO - VARIABLES DE ENTORNO DESPLIEGUE HÍBRIDO (AWS + GPU PRIVADA)
# ==============================================================================
# Web & Base de datos en AWS (ECS/RDS/S3) + Inferencia en Servidor GPU Privado
# La información confidencial NUNCA se procesa en proveedores comerciales de IA
# ==============================================================================

# Entorno
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="LegalAI México"
VERSION="1.0.0"

# Servidor Backend
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=REEMPLAZAR_CON_STRING_CRIPTOGRAFICO_ALEATORIO_DE_64_CHARS_MINIMO
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# AWS RDS PostgreSQL 16 (Multi-AZ en Subredes Privadas con Cifrado KMS)
POSTGRES_SERVER=legal-ai-rds.c12345678.us-east-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_USER=legal_admin
POSTGRES_PASSWORD=PASSWORD_RDS_COMPLEJO_GESTIONADO_EN_AWS_SECRETS_MANAGER
POSTGRES_DB=legal_ai_db
DATABASE_URL=postgresql://legal_admin:PASSWORD_RDS_COMPLEJO_GESTIONADO_EN_AWS_SECRETS_MANAGER@legal-ai-rds.c12345678.us-east-1.rds.amazonaws.com:5432/legal_ai_db?sslmode=require

# AWS ElastiCache Redis (Cifrado en tránsito y token de autenticación)
REDIS_HOST=clustercfg.legal-ai-cache.xyz.use1.cache.amazonaws.com
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=TOKEN_AUTENTICACION_ELASTICACHE
REDIS_URL=rediss://:TOKEN_AUTENTICACION_ELASTICACHE@clustercfg.legal-ai-cache.xyz.use1.cache.amazonaws.com:6379/0

# Inferencia IA Soberana (Túnel VPN IPSec a Servidor GPU On-Premises Privado)
# Conexión privada autenticada sobre AWS Site-to-Site VPN
OLLAMA_BASE_URL=https://gpu-server.internal.despacho.com.mx:11434
OLLAMA_API_KEY=BEARER_TOKEN_CONEXION_SEGURA_VPN
OLLAMA_ALLOW_PUBLIC_IPS=false
OLLAMA_VERIFY_SSL=true
OLLAMA_EMBEDDING_MODEL=bge-m3:latest
OLLAMA_LLM_MODEL=qwen3.5:4b
OLLAMA_CODER_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SECONDS=180

# Almacenamiento Documental Inmutable en AWS S3 con Object Lock (WORM)
STORAGE_BACKEND=s3
AWS_REGION=us-east-1
S3_BUCKET_NAME=legal-ai-documents-vault-prod
S3_SERVER_SIDE_ENCRYPTION=aws:kms
S3_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/12345678-1234-1234-1234-123456789012
STORAGE_WORM_ENABLED=true

# Monitoreo en AWS CloudWatch
CLOUDWATCH_ENABLED=true
CLOUDWATCH_LOG_GROUP=/aws/ecs/legal-ai-production
LOG_LEVEL=INFO

# CORS Origins
CORS_ORIGINS="https://legal.despacho.com.mx,https://app.legalai.mx"

# Frontend Next.js
NEXT_PUBLIC_API_URL=https://legal.despacho.com.mx/api/v1
NEXT_PUBLIC_APP_NAME="LegalAI México"
